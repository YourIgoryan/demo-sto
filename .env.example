# Generate a long random value before public deployment.
AUTOSTUDIO_SECRET=replace-with-a-long-random-secret
# Optional absolute path to SQLite database.
# AUTOSTUDIO_DB=C:\\AutoStudioData\\autostudio.db
# Comma-separated frontend origins if frontend is hosted separately.
CORS_ORIGINS=http://127.0.0.1:5173,https://your-domain.example

# Optional model; key remains on the backend only.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_REQUESTS_PER_DAY=80
# Optional WhatsApp Cloud API notifications for newly created bookings.
# Keep real credentials in your local .env; never commit them.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=
WHATSAPP_TEMPLATE_NAME=booking_notification
WHATSAPP_TEMPLATE_LANGUAGE=ru
WHATSAPP_GRAPH_API_VERSION=v23.0
