# Generate a random value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTOSTUDIO_SECRET=replace-this-with-a-long-random-secret
DOMAIN=your-domain.example
CORS_ORIGINS=*

# Optional: server-side AI assistant. Leave blank to use verified rule-based answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_REQUESTS_PER_DAY=80
# Optional WhatsApp Cloud API notifications for newly created bookings.
# Keep real credentials in your local .env; never commit them.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=
WHATSAPP_TEMPLATE_NAME=booking_notification
WHATSAPP_TEMPLATE_LANGUAGE=ru
WHATSAPP_GRAPH_API_VERSION=v23.0
